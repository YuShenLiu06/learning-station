{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "学习站",
  "version": "0.1.0",
  "identifier": "cn.yushen.learning-station",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/prepare-runtime.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "学习站",
        "width": 1440,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'self' https:; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../pi-sidecar/sidecar.mjs": "pi-sidecar/sidecar.mjs",
      "../pi-sidecar/harness.mjs": "pi-sidecar/harness.mjs",
      "../pi-sidecar/package.json": "pi-sidecar/package.json",
      "../pi-sidecar/package-lock.json": "pi-sidecar/package-lock.json",
      "../pi-sidecar/node_modules/": "pi-sidecar/node_modules/",
      "../pi-sidecar/learning-plugin.mjs": "pi-sidecar/learning-plugin.mjs",
      "../pi-sidecar/response-diagnostics.mjs": "pi-sidecar/response-diagnostics.mjs",
      "../runtime/LICENSE": "runtime/LICENSE",
      "../tools/feishu-bot/worker.mjs": "feishu-bot/worker.mjs",
      "../tools/feishu-bot/adapter.mjs": "feishu-bot/adapter.mjs",
      "../tools/feishu-bot/package.json": "feishu-bot/package.json",
      "../tools/feishu-bot/package-lock.json": "feishu-bot/package-lock.json",
      "../tools/feishu-bot/node_modules/": "feishu-bot/node_modules/",
      "../runtime/manifest.json": "runtime/manifest.json",
      "../pi-sidecar/learning-skills.mjs": "pi-sidecar/learning-skills.mjs",
      "../skills/learning-explore/SKILL.md": "skills/learning-explore/SKILL.md",
      "../skills/learning-review/SKILL.md": "skills/learning-review/SKILL.md",
      "../skills/learning-exercises/SKILL.md": "skills/learning-exercises/SKILL.md",
      "../skills/learning-exercise-markdown/SKILL.md": "skills/learning-exercise-markdown/SKILL.md",
      "../pi-sidecar/time-context.mjs": "pi-sidecar/time-context.mjs",
      "../THIRD_PARTY_NOTICES/pi-readcache.txt": "licenses/pi-readcache.txt",
      "../THIRD_PARTY_NOTICES/codemirror-json.txt": "licenses/codemirror-json.txt",
      "../pi-sidecar/request-debug.mjs": "pi-sidecar/request-debug.mjs",
      "../pi-sidecar/native-session.mjs": "pi-sidecar/native-session.mjs",
      "../pi-sidecar/context-bridge.mjs": "pi-sidecar/context-bridge.mjs",
      "../pi-sidecar/material-context.mjs": "pi-sidecar/material-context.mjs"
    }
  }
}
