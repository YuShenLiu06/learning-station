{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "学习站",
  "version": "0.1.0",
  "identifier": "cn.yushen.learning-station",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "学习站",
        "width": 1440,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "../pi-sidecar/sidecar.mjs": "pi-sidecar/sidecar.mjs",
      "../pi-sidecar/harness.mjs": "pi-sidecar/harness.mjs",
      "../pi-sidecar/package.json": "pi-sidecar/package.json",
      "../pi-sidecar/package-lock.json": "pi-sidecar/package-lock.json",
      "../pi-sidecar/node_modules/": "pi-sidecar/node_modules/",
      "../pi-sidecar/learning-plugin.mjs": "pi-sidecar/learning-plugin.mjs"
    }
  }
}
